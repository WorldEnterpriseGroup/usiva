---

<footer class="site-footer">
  <div class="shell-container">
    <div class="site-footer__grid">
      <div class="site-footer__lead">
        <a href="/" aria-label="USIVA home">
          <span class="footer-brand">
            <span class="footer-brand__mark" aria-hidden="true">US</span>
            <span class="footer-brand__name">USIVA</span>
          </span>
        </a>
        <p>Visa-readiness and compliance planning for international study and research pathways.</p>
      </div>

      <div>
        <h2>USIVA</h2>
        <ul>
          <li><a href="/international-rd-scholars.html">R&amp;D Scholars</a></li>
          <li><a href="/#services">Services</a></li>
          <li><a href="/#boundaries">Compliance</a></li>
        </ul>
      </div>

      <div>
        <h2>US Fellows</h2>
        <ul>
          <li><a href="https://usfellows.org/international-rd-scholars.html">International R&amp;D Scholars</a></li>
          <li><a href="https://usfellows.org/apply.html">Apply</a></li>
          <li><a href="https://usfellows.org/submit-opportunity.html">Partner</a></li>
        </ul>
      </div>

      <div>
        <h2>Notice</h2>
        <p>USIVA planning content is informational. It does not guarantee admission, employment, funding, visa issuance, or government approval, and it does not replace individualized legal advice.</p>
      </div>
    </div>

    <div class="site-footer__bottom">
      <span>&copy; 2026 USIVA. A US Council companion site.</span>
      <a href="/sitemap.xml">Sitemap</a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-navy-deep);
    color: #c8d5dc;
    padding-block: var(--space-4) var(--space-3);
  }

  .site-footer__grid {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: 1.3fr repeat(3, 0.78fr);
  }

  .site-footer__lead {
    padding-inline-end: var(--space-3);
  }

  .site-footer h2 {
    color: var(--color-paper);
    font-family: var(--font-body);
    font-size: var(--step--1);
    letter-spacing: 0.09em;
    margin-block-end: 0.9rem;
    text-transform: uppercase;
  }

  .site-footer p {
    color: #c8d5dc;
    font-size: var(--step--1);
    margin-block-start: 1rem;
  }

  .site-footer ul {
    list-style: none;
  }

  .site-footer li + li {
    margin-block-start: 0.45rem;
  }

  .site-footer a {
    color: inherit;
    text-decoration: none;
  }

  .site-footer a:hover {
    color: var(--color-highlight);
  }

  .footer-brand {
    align-items: center;
    display: inline-flex;
    gap: 0.7rem;
  }

  .footer-brand__mark {
    align-items: center;
    border: 2px solid var(--color-gold);
    border-radius: 50%;
    color: var(--color-paper);
    display: inline-flex;
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 700;
    height: 2.7rem;
    justify-content: center;
    width: 2.7rem;
  }

  .footer-brand__name {
    color: var(--color-paper);
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 700;
    letter-spacing: -0.04em;
  }

  .site-footer__bottom {
    align-items: center;
    border-top: 1px solid rgba(214, 225, 229, 0.2);
    display: flex;
    font-size: var(--step--1);
    gap: 1rem;
    justify-content: space-between;
    margin-block-start: var(--space-4);
    padding-block-start: var(--space-2);
  }

  @media (max-width: 900px) {
    .site-footer__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .site-footer__lead {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .site-footer__grid {
      grid-template-columns: 1fr;
    }

    .site-footer__bottom {
      align-items: flex-start;
      flex-direction: column;
    }
  }
</style>
