---
import {
  getOfficialResource,
  uscisCaseStatusContract,
} from '../data/official-resources';

const caseStatus = getOfficialResource('uscis-case-status');
const myUscis = getOfficialResource('uscis-my-account');
const processingTimes = getOfficialResource('uscis-processing-times');
const apiDocs = getOfficialResource('uscis-case-status-api');
---

<section class="uscis-status-panel" id="uscis-integration" aria-labelledby="uscis-status-title">
  <div class="shell-container">
    <div class="uscis-status-panel__intro">
      <p class="eyebrow">Transparent integration boundary</p>
      <h2 id="uscis-status-title">A static page cannot look up your case.</h2>
      <p>
        This panel is API-ready documentation, not a live status checker. It does not accept a receipt number, call USCIS, proxy a user receipt number or myUSCIS session, or return case data. Use the official handoffs for the current answer.
      </p>
      <span class="uscis-status-panel__badge">Static handoff only · no live case data</span>
    </div>

    <div class="uscis-status-panel__grid">
      <div class="uscis-status-panel__contract">
        <p class="uscis-status-panel__label">Future server-side contract</p>
        <h3>What an approved integration would have to protect.</h3>
        <dl class="contract-list">
          <div>
            <dt>Browser request</dt>
            <dd><code>{uscisCaseStatusContract.clientRequest.method} {uscisCaseStatusContract.futureServerRoute}</code></dd>
          </div>
          <div>
            <dt>USCIS operation</dt>
            <dd><code>{uscisCaseStatusContract.upstream.operation}</code> through the <a href={uscisCaseStatusContract.upstream.documentation}>Case Status API docs</a>.</dd>
          </div>
          <div>
            <dt>Authentication</dt>
            <dd>{uscisCaseStatusContract.upstream.authentication}; credentials stay on the server.</dd>
          </div>
          <div>
            <dt>Response posture</dt>
            <dd>{uscisCaseStatusContract.clientRequest.response}</dd>
          </div>
        </dl>

        <ol class="contract-steps">
          {uscisCaseStatusContract.serverResponsibilities.map((responsibility, index) => (
            <li>
              <span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
              <p>{responsibility}</p>
            </li>
          ))}
        </ol>
      </div>

      <aside class="uscis-status-panel__handoffs" aria-labelledby="uscis-handoffs-title">
        <p class="uscis-status-panel__label">Official handoffs</p>
        <h3 id="uscis-handoffs-title">Go to the source that owns the result.</h3>
        <ul>
          <li>
            <a href={caseStatus.href}>{caseStatus.label}<span aria-hidden="true">↗</span></a>
            <p>{caseStatus.summary}</p>
          </li>
          <li>
            <a href={myUscis.href}>{myUscis.label}<span aria-hidden="true">↗</span></a>
            <p>{myUscis.summary}</p>
          </li>
          <li>
            <a href={processingTimes.href}>{processingTimes.label}<span aria-hidden="true">↗</span></a>
            <p>{processingTimes.summary}</p>
          </li>
          <li>
            <a href={apiDocs.href}>{apiDocs.label}<span aria-hidden="true">↗</span></a>
            <p>{apiDocs.summary}</p>
          </li>
        </ul>
        <p class="uscis-status-panel__note">{uscisCaseStatusContract.staticPageBehavior[2]}</p>
      </aside>
    </div>
  </div>
</section>

<style>
  .uscis-status-panel {
    background: var(--color-navy-deep);
    color: var(--color-paper);
    padding-block: var(--space-5);
  }

  .uscis-status-panel__intro {
    max-width: 52rem;
  }

  .uscis-status-panel h2,
  .uscis-status-panel h3 {
    color: var(--color-paper);
  }

  .uscis-status-panel h2 {
    font-size: var(--step-3);
    max-width: 15ch;
  }

  .uscis-status-panel__intro > p:not(.eyebrow) {
    color: #d6e1e5;
    font-size: var(--step-0);
    max-width: 60ch;
  }

  .uscis-status-panel__badge {
    background: var(--color-highlight);
    color: var(--color-navy-deep);
    display: inline-flex;
    font-size: var(--step--1);
    font-weight: 850;
    letter-spacing: 0.04em;
    margin-block-start: var(--space-1);
    padding: 0.55rem 0.8rem;
  }

  .uscis-status-panel__grid {
    display: grid;
    gap: clamp(2rem, 6vw, 6rem);
    grid-template-columns: minmax(0, 1.1fr) minmax(18rem, 0.9fr);
    margin-block-start: var(--space-4);
  }

  .uscis-status-panel__contract,
  .uscis-status-panel__handoffs {
    border-top: 1px solid rgba(214, 225, 229, 0.3);
    padding-block-start: var(--space-2);
  }

  .uscis-status-panel__label {
    color: var(--color-highlight);
    font-size: var(--step--1);
    font-weight: 850;
    letter-spacing: 0.14em;
    margin-block-end: var(--space-1);
    text-transform: uppercase;
  }

  .uscis-status-panel h3 {
    font-size: var(--step-1);
    margin-block-end: var(--space-2);
  }

  .contract-list {
    border-block: 1px solid rgba(214, 225, 229, 0.25);
  }

  .contract-list > div {
    display: grid;
    gap: 1rem;
    grid-template-columns: minmax(7rem, 0.35fr) minmax(0, 1fr);
    padding-block: 0.9rem;
  }

  .contract-list > div + div {
    border-top: 1px solid rgba(214, 225, 229, 0.16);
  }

  .contract-list dt {
    color: #b9cbd3;
    font-size: var(--step--1);
    font-weight: 800;
  }

  .contract-list dd {
    color: #ecf2f3;
    font-size: var(--step--1);
    margin: 0;
  }

  .contract-list code {
    color: var(--color-highlight);
    font-family: var(--font-mono);
    overflow-wrap: anywhere;
  }

  .uscis-status-panel a {
    color: var(--color-highlight);
    font-weight: 800;
  }

  .uscis-status-panel a:hover {
    color: var(--color-paper);
  }

  .contract-steps {
    list-style: none;
    margin-block-start: var(--space-2);
  }

  .contract-steps li {
    align-items: start;
    display: grid;
    gap: 1rem;
    grid-template-columns: 2rem minmax(0, 1fr);
    padding-block: 0.75rem;
  }

  .contract-steps li + li {
    border-top: 1px solid rgba(214, 225, 229, 0.16);
  }

  .contract-steps span {
    color: var(--color-gold);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .contract-steps p {
    color: #d6e1e5;
    font-size: var(--step--1);
    margin: 0;
  }

  .uscis-status-panel__handoffs {
    background: rgba(255, 255, 255, 0.06);
    border-top-color: var(--color-gold);
    padding: var(--space-2);
  }

  .uscis-status-panel__handoffs ul {
    list-style: none;
  }

  .uscis-status-panel__handoffs li {
    padding-block: 0.85rem;
  }

  .uscis-status-panel__handoffs li + li {
    border-top: 1px solid rgba(214, 225, 229, 0.16);
  }

  .uscis-status-panel__handoffs li a {
    display: inline-block;
    font-size: var(--step--1);
  }

  .uscis-status-panel__handoffs li a span {
    display: inline-block;
    margin-inline-start: 0.35rem;
  }

  .uscis-status-panel__handoffs li p {
    color: #b9cbd3;
    font-size: var(--step--1);
    margin-block-start: 0.25rem;
  }

  .uscis-status-panel__note {
    border-top: 1px solid rgba(214, 225, 229, 0.25);
    color: #d6e1e5;
    font-size: var(--step--1);
    margin-block-start: var(--space-2);
    padding-block-start: var(--space-2);
  }

  @media (max-width: 800px) {
    .uscis-status-panel__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .contract-list > div {
      display: block;
    }

    .contract-list dt {
      margin-block-end: 0.25rem;
    }
  }
</style>
